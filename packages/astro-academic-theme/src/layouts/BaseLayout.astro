---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SiteConfig } from '../types.js';
import { getNavItems, isNavActive } from '../lib/nav.js';
import { withBase } from '../lib/paths.js';

interface Props {
  config: SiteConfig;
  title?: string;
  description?: string;
  showUserInfo?: boolean;
  currentPath?: string;
}

const {
  config,
  title,
  description,
  showUserInfo = true,
  currentPath = '/',
} = Astro.props;

const pageTitle = title ? `${title} | ${config.title}` : config.title;
const pageDescription = description || config.description;

const navItems = getNavItems(config);
const activeNavItem = navItems.find(item => isNavActive(currentPath, item.href, item.exact));
const mainPaths = navItems.flatMap(n => [n.href, n.href.replace(/\/$/, '')]);
const isMainTabPage = mainPaths.includes(currentPath);
---

<!doctype html>
<html lang={config.defaultLanguage || 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={config.author} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={config.siteUrl} />
    <meta property="og:image" content={`${config.siteUrl}/${config.avatar}`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${config.siteUrl}/${config.avatar}`} />
    <title>{pageTitle}</title>
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Source+Serif+4:ital,opsz,wght@0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,500&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/academicons/1.9.4/css/academicons.min.css"
      integrity="sha512-IW0nhlW5MgNydsXJO40En2EoCkTTjZhI3yuODrZIc8cQ4h1XcF53PsqDHa09NqnkXuIe0Oiyyj171BqZFwISBw=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous" />

    <script is:inline>
      (function(){
        var s=localStorage.getItem('theme'),d=window.matchMedia('(prefers-color-scheme:dark)').matches;
        if(s==='dark'||(!s&&d))document.documentElement.classList.add('dark');
        if(!window._themeSwap){
          document.addEventListener('astro:before-swap',function(e){
            e.newDocument.documentElement.classList.toggle('dark',
              document.documentElement.classList.contains('dark'));
          });
          window._themeSwap=true;
        }
      })();
    </script>
  </head>

  <body>
    <div class="shell">
      <Header config={config} currentPath={currentPath} />
      <div class:list={['page-body', { 'has-rail': !showUserInfo }]}>
        <main class="main-col">
          {!isMainTabPage && activeNavItem && (
            <a href={withBase(activeNavItem.href)} class="back-link">
              <i class="fas fa-arrow-left"></i> {activeNavItem.label}
            </a>
          )}
          {isMainTabPage && activeNavItem && activeNavItem.href !== '/' && (
            <h1 class="page-kicker">{activeNavItem.label}</h1>
          )}
          <slot />
        </main>
        {!showUserInfo && (
          <aside class="toc-rail">
            <slot name="sidebar" />
          </aside>
        )}
      </div>
      <Footer />
    </div>
  </body>
</html>

<style>
  html {
    overscroll-behavior-y: none;
  }

  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    overflow-y: scroll;
    overflow-x: clip;
  }

  .shell {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.5rem 2.5rem;
  }

  .page-body {
    display: block;
    padding-top: 1.75rem;
  }

  .page-body.has-rail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    gap: 2.5rem;
    align-items: start;
  }

  .main-col {
    min-width: 0;
  }

  .toc-rail {
    position: sticky;
    top: 5.5rem;
    font-size: 0.88rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 0.9rem;
  }

  .back-link:hover {
    color: var(--color-link);
  }

  .page-kicker {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    margin: 0 0 1.4rem;
  }

  @media (max-width: 840px) {
    .page-body.has-rail {
      grid-template-columns: 1fr;
    }

    .toc-rail {
      position: static;
      order: -1;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 1rem;
      margin-bottom: 0.5rem;
    }
  }
</style>
